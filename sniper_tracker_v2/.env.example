# Шаблон настроек. Скопируйте в .env и заполните. Файл .env в git не попадает.
# Секреты генерируются так:
#   python -c "import secrets; print(secrets.token_hex(24))"       (пароли)
#   python -c "import secrets; print(secrets.token_urlsafe(64))"   (SECRET_KEY)

# development (локально) или production (сервер; docker-compose.prod.yml выставляет его сам)
ENVIRONMENT=development

# Домен сайта для HTTPS (только для docker-compose.prod.yml), например sniper.example.com
SITE_ADDRESS=

# База данных
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=sniper_db
DATABASE_URL=postgresql+asyncpg://postgres:<POSTGRES_PASSWORD>@db:5432/sniper_db

# Redis
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

# Ключ подписи токенов входа (минимум 32 символа). Утечка = доступ к любому аккаунту
SECRET_KEY=

# Telegram-бот (токен от @BotFather) и его имя без @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Адреса фронтенда, которым разрешено обращаться к API напрямую (через запятую).
# В production фронтенд и API на одном домене, можно указать https://<ваш домен>
CORS_ORIGINS=http://localhost:5173

# Кнопка "Оплатить тестово" — только для локальной разработки
ENABLE_TEST_PAYMENTS=false

PROXIES=

# Порт API на хосте при локальной разработке
API_PORT=8000
